{
	"luci-app-snort": {
		"description": "Grant LuCI access to Snort3 RPC methods and log reading",
		"read": {
			"ubus": {
				"luci.snort": [
					"get_status",
					"get_alerts",
					"check_update_status"
				],
				"log": [
					"read"
				],
				"luci": [
					"getInitList"
				]
			}
		},
		"write": {
			"ubus": {
				"luci.snort": [
					"update_rules",
					"cleanup_temp",
					"fix_rules"
				],
				"luci": [
					"setInitAction"
				]
			}
		}
	}
}
